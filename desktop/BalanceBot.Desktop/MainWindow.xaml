<Window x:Class="BalanceBot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BalanceBot.Desktop"
        xmlns:views="clr-namespace:BalanceBot.Desktop.Views"
        Title="BalanceBot Studio — Монитор и Тюнинг"
        MinHeight="600" MinWidth="900"
        Height="850" Width="1400"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель статуса -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16" Padding="12,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Логотип + статус -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE99A; BALANCE-BOT"
                               FontFamily="Segoe Fluent Icons, Segoe UI"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Border Background="{StaticResource BgDarkBrush}"
                            CornerRadius="6"
                            Padding="10,6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            MaxWidth="340">
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ConnectionStatus}" />
                    </Border>
                </StackPanel>

                <!-- Подключение -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="&#xE721; Поиск"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ScanNetworkCommand}"
                            IsEnabled="{Binding CanEditInputs}"
                            Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding DiscoveredRobots}"
                              SelectedItem="{Binding SelectedRobot}"
                              DisplayMemberPath="DisplayName"
                              Width="210" MinWidth="150"
                              IsEnabled="{Binding CanEditInputs}"
                              Margin="0,0,8,0"
                              VerticalContentAlignment="Center" />
                    <TextBox Text="{Binding ManualIp}"
                             Style="{StaticResource ModernTextBox}"
                             Width="130" MinWidth="110"
                             IsEnabled="{Binding CanEditInputs}"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center" />

                    <Button Content="Подключить"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding ConnectCommand}"
                            Visibility="{Binding CanConnect, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,6,0" />
                    <Button Content="Отмена"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding CancelConnectCommand}"
                            Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,6,0" Padding="14,8" />
                    <Button Content="Отключить"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding DisconnectCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Запись CSV -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="{Binding Dashboard.RecordingButtonText, FallbackValue='&#xE7C8; Запись CSV'}"
                            Command="{Binding Dashboard.ToggleRecordingCommand}"
                            IsEnabled="{Binding IsConnected}"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dashboard.IsRecording}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#xE8B7; Логи"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding Dashboard.OpenLogsFolderCommand}"
                            ToolTip="Открыть папку с логами" />
                </StackPanel>

                <!-- Арм / Дизарм -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="ВКЛЮЧИТЬ БАЛАНС"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding ArmRobotCommand}"
                            IsEnabled="{Binding IsConnected}"
                            Margin="0,0,8,0" Padding="20,10" />
                    <Button Content="СТОП (ПРОБЕЛ)"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding DisarmRobotCommand}"
                            IsEnabled="{Binding IsConnected}"
                            Padding="20,10" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="1">
            <TabItem Header="&#xE9D2; Осциллограф">
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </TabItem>
            <TabItem Header="&#xE713; Тюнинг PID">
                <views:TuningView DataContext="{Binding Tuning}" />
            </TabItem>
            <TabItem Header="&#xE7FC; Управление">
                <views:ControlView DataContext="{Binding Control}" />
            </TabItem>
            <TabItem Header="&#xE701; Wi-Fi сети">
                <views:WifiView DataContext="{Binding Wifi}" />
            </TabItem>
            <TabItem Header="&#xE7B8; Чёрный ящик">
                <views:BlackBoxView DataContext="{Binding BlackBox}" />
            </TabItem>
            <TabItem Header="&#xE9D2; Устойчивость">
                <views:BodeView DataContext="{Binding Bode}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
