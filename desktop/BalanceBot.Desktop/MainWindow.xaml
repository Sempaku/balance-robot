<Window x:Class="BalanceBot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BalanceBot.Desktop"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="BalanceBot Studio — Монитор и Тюнинг" Height="900" Width="1440"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ СТАТУСА -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16" Padding="12,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🤖 BALANCE-BOT" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Background="#12141A" CornerRadius="6" Padding="10,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxWidth="340">
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionStatus}" />
                    </Border>
                </StackPanel>

                <!-- Подключение к IP -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="🔍 Поиск" Style="{StaticResource SecondaryButton}" Command="{Binding ScanNetworkCommand}" IsEnabled="{Binding CanEditInputs}" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding DiscoveredRobots}" SelectedItem="{Binding SelectedRobot}" DisplayMemberPath="DisplayName" Width="210" IsEnabled="{Binding CanEditInputs}" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                    <TextBox Text="{Binding ManualIp}" Style="{StaticResource ModernTextBox}" Width="130" IsEnabled="{Binding CanEditInputs}" Margin="0,0,8,0" VerticalContentAlignment="Center" />

                    <Button Content="Подключить" Style="{StaticResource ModernButton}" Command="{Binding ConnectCommand}" Visibility="{Binding CanConnect, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0" />
                    <Button Content="Отмена" Style="{StaticResource DangerButton}" Command="{Binding CancelConnectCommand}" Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0" Padding="14,8" />
                    <Button Content="Отключить" Style="{StaticResource SecondaryButton}" Command="{Binding DisconnectCommand}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Запись CSV -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Content="{Binding Dashboard.RecordingButtonText, FallbackValue='⏺ Запись CSV'}"
                            Command="{Binding Dashboard.ToggleRecordingCommand}"
                            IsEnabled="{Binding IsConnected}"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dashboard.IsRecording}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="📁 Логи" Style="{StaticResource SecondaryButton}" Command="{Binding Dashboard.OpenLogsFolderCommand}" ToolTip="Открыть папку с логами" />
                </StackPanel>

                <!-- АРМ / ДИЗАРМ -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="ВКЛЮЧИТЬ БАЛАНС" Style="{StaticResource SuccessButton}" Command="{Binding ArmRobotCommand}" IsEnabled="{Binding IsConnected}" Margin="0,0,8,0" Padding="20,10" />
                    <Button Content="СТОП (ПРОБЕЛ)" Style="{StaticResource DangerButton}" Command="{Binding DisarmRobotCommand}" IsEnabled="{Binding IsConnected}" Padding="20,10" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ВКЛАДКИ -->
        <TabControl Grid.Row="1">
            <!-- 1. ДАШБОРД -->
            <TabItem Header="📈 Осциллограф и Дашборд">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Метрики в реальном времени -->
                    <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,12">
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="СОСТОЯНИЕ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Dashboard.StateText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="УГОЛ НАКЛОНА" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Dashboard.Angle, StringFormat={}{0:F2}°}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="ГИРОСКОП" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Dashboard.Gyro, StringFormat={}{0:F1}°/с}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="ТЯГА ПРИВОДА (CMD)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Dashboard.CmdRps, StringFormat={}{0:F2} об/с}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="СКОРОСТЬ КОЛЕС" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Dashboard.WheelRateRps, StringFormat={}{0:F2} об/с}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ЦИКЛ / ОШИБКИ IMU" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Dashboard.DtUs, StringFormat={}{0} мкс}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text=" | " FontSize="18" Foreground="{StaticResource BorderBrush}" />
                                    <TextBlock Text="{Binding Dashboard.ImuErrors}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ДВА ГРАФИКА + БОКОВАЯ ПАНЕЛЬ -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="310" />
                        </Grid.ColumnDefinitions>

                        <!-- ДВА ГРАФИКА ДРУГ ПОД ДРУГОМ -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,8" Padding="4">
                                <ScottPlot:WpfPlot x:Name="PlotOrientation" />
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,8,0,0" Padding="4">
                                <ScottPlot:WpfPlot x:Name="PlotMotors" />
                            </Border>
                        </Grid>

                        <!-- БОКОВАЯ ПАНЕЛЬ: КАЛИБРОВКА ТРИМА И ТУМБЛЕРЫ КАНАЛОВ -->
                        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- БЛОК ПОДСТРОЙКИ ТОЧКИ РАВНОВЕСИЯ (ТРИМ) -->
                                    <TextBlock Text="ТОЧКА РАВНОВЕСИЯ (ТРИМ)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                    <Border Background="#12141A" CornerRadius="8" Padding="10" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Смещение угла:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Dashboard.TrimOffset, StringFormat={}{0:+0.00;-0.00;0.00}°}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                            </Grid>

                                            <!-- Слайдер трима на лету -->
                                            <Slider Minimum="-5.0" Maximum="5.0" Value="{Binding Dashboard.TrimOffset}" SmallChange="0.05" LargeChange="0.2" TickFrequency="0.5" IsSnapToTickEnabled="False" Margin="0,2,0,8" />

                                            <!-- Кнопки быстрого микрошага -->
                                            <UniformGrid Columns="5" Margin="0,2,0,0">
                                                <Button Content="-0.2°" Style="{StaticResource SecondaryButton}" Padding="4,4" FontSize="11" Command="{Binding Dashboard.AdjustTrimCommand}" CommandParameter="-0.2" Margin="1" />
                                                <Button Content="-0.05°" Style="{StaticResource SecondaryButton}" Padding="2,4" FontSize="10" Command="{Binding Dashboard.AdjustTrimCommand}" CommandParameter="-0.05" Margin="1" />
                                                <Button Content="0.0°" Style="{StaticResource SecondaryButton}" Padding="4,4" FontSize="11" Command="{Binding Dashboard.ResetTrimCommand}" Margin="1" />
                                                <Button Content="+0.05°" Style="{StaticResource SecondaryButton}" Padding="2,4" FontSize="10" Command="{Binding Dashboard.AdjustTrimCommand}" CommandParameter="0.05" Margin="1" />
                                                <Button Content="+0.2°" Style="{StaticResource SecondaryButton}" Padding="4,4" FontSize="11" Command="{Binding Dashboard.AdjustTrimCommand}" CommandParameter="0.2" Margin="1" />
                                            </UniformGrid>
                                            <TextBlock Text="Подстройка: клавиши [ и ]" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Кнопки управления графиком -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{Binding Dashboard.PauseButtonText}" Style="{StaticResource SecondaryButton}" Command="{Binding Dashboard.TogglePauseCommand}" Margin="0,0,4,0" />
                                        <Button Grid.Column="1" Content="⟲ Масштаб" Style="{StaticResource SecondaryButton}" Command="{Binding Dashboard.ResetAxesCommand}" Margin="4,0,0,0" />
                                    </Grid>

                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />

                                    <!-- КАНАЛЫ ОРИЕНТАЦИИ -->
                                    <TextBlock Text="ОРИЕНТАЦИЯ И ДАТЧИКИ (°)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                                    <CheckBox IsChecked="{Binding Dashboard.ShowAngle}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="#3D7EFF" Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
                                            <TextBlock Text="Угол фильтра (°)" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding Dashboard.ShowGyro}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="#00E676" Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
                                            <TextBlock Text="Гироскоп (°/с)" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding Dashboard.ShowTrim}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="#E8EAF0" Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
                                            <TextBlock Text="Точка баланса Trim (°)" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding Dashboard.ShowAccelAngle}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="#80D8FF" Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
                                            <TextBlock Text="Сырой акселерометр (°)" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding Dashboard.ShowLean}" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="#FF6D00" Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
                                            <TextBlock Text="Целевой наклон Lean (°)" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>

                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />

                                    <!-- КАНАЛЫ МОТОРОВ -->
                                    <TextBlock Text="МОТОРЫ И КОНТУР (об/с)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                                    <CheckBox IsChecked="{Binding Dashboard.ShowCmd}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="#FFB300" Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
                                            <TextBlock Text="Команда привода (об/с)" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding Dashboard.ShowWheelRate}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="#B388FF" Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
                                            <TextBlock Text="Скорость колес (об/с)" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding Dashboard.ShowTermP}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="#FF4081" Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
                                            <TextBlock Text="Вклад P-члена" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding Dashboard.ShowTermD}" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" Fill="#78909C" Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
                                            <TextBlock Text="Вклад D-члена" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 2. ТЮНИНГ ПИД -->
            <TabItem Header="⚙ Тюнинг PID на лету">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Панель автонастройки -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="🤖 Автотюнинг" Style="{StaticResource ModernButton}" FontSize="14"
                                    Command="{Binding Tuning.RunAutotuneCommand}"
                                    Margin="0,0,14,0" Padding="18,10" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tuning.AutotuneStatusText}" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                           TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Tuning.AutotuneResultText}" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding Tuning.HasAutotuneResult, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="↩ Откатить" Style="{StaticResource SecondaryButton}" FontSize="12"
                                    Command="{Binding Tuning.RollbackAutotuneCommand}" IsEnabled="{Binding Tuning.HasAutotuneResult}"
                                    Margin="14,0,0,0" Padding="12,8" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tuning.Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Meta.Key}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Text="{Binding Meta.About}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Slider Grid.Column="1" Minimum="{Binding Meta.Min}" Maximum="{Binding Meta.Max}" Value="{Binding CurrentValue}" VerticalAlignment="Center" Margin="16,0" />

                                                <TextBox Grid.Column="2" Text="{Binding CurrentValue, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" VerticalAlignment="Center" HorizontalContentAlignment="Center" />

                                                <TextBlock Grid.Column="3" Text="{Binding Meta.Unit}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Tuning.StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Сброс к заводским" Style="{StaticResource SecondaryButton}" Command="{Binding Tuning.ResetToDefaultsCommand}" Margin="0,0,8,0" />
                                <Button Content="Применить (RAM)" Style="{StaticResource ModernButton}" Command="{Binding Tuning.ApplyCommand}" Margin="0,0,8,0" />
                                <Button Content="💾 Сохранить в NVS" Style="{StaticResource SuccessButton}" Command="{Binding Tuning.SaveToNvsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. УПРАВЛЕНИЕ (WASD / ГЕЙМПАД) -->
            <TabItem Header="🕹 Управление (WASD / геймпад)">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="ПУЛЬТ УПРАВЛЕНИЯ" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16" />

                            <Border Background="#12141A" CornerRadius="8" Padding="14" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Управление клавиатурой" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="WASD или стрелки" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Control.IsKeyboardActive}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="#12141A" CornerRadius="8" Padding="14" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Геймпад DualSense (USB / Bluetooth)" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Control.GamepadStatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Control.IsGamepadActive}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="✕ — баланс, ○ — стоп, PS — аварийный стоп, D-pad ↑↓ — трим ±0.1°, R2 — форсаж, create — вкл/выкл"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="🔄 Поиск" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,5"
                                                Command="{Binding Control.RescanGamepadsCommand}" Margin="0,0,6,0" />
                                        <Button Content="⚙ Авто" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,5"
                                                Command="{Binding Control.UseAutoGamepadCommand}" Margin="0,0,6,0"
                                                ToolTip="Вернуться к автопоиску DualSense" />
                                        <Button Content="📳 Тест" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,5"
                                                Command="{Binding Control.TestRumbleCommand}"
                                                ToolTip="Тест вибрации и lightbar" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ОГРАНИЧЕНИЕ ТЯГИ ХОДА" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Grid Margin="0,4,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0.1" Maximum="1.0" Value="{Binding Control.SpeedScale}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Control.SpeedScale, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" />
                            </Grid>

                            <TextBlock Text="ЧУВСТВИТЕЛЬНОСТЬ РАЗВОРОТА" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Grid Margin="0,4,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0.1" Maximum="1.0" Value="{Binding Control.TurnScale}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Control.TurnScale, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" />
                            </Grid>

                            <Border Background="#12141A" CornerRadius="8" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="ТЕКУЩИЙ ВЫХОД В UDP (Watchdog 300ms)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Control.CurrentForward, StringFormat={}Forward: {0:+0.00;-0.00;0.00}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding Control.CurrentTurn, StringFormat={}Turn:    {0:+0.00;-0.00;0.00}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <TextBlock Text="РАСКЛАДКА КЛАВИАТУРЫ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                                <Border Background="#12141A" CornerRadius="8" Width="90" Height="80" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="▲" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="W" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Вперёд" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Background="#12141A" CornerRadius="8" Width="90" Height="80" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" Margin="0,0,10,0">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="◀" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="A" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Влево" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#12141A" CornerRadius="8" Width="90" Height="80" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" Margin="0,0,10,0">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="▼" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="S" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Назад" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#12141A" CornerRadius="8" Width="90" Height="80" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="▶" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="D" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="Вправо" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Клавиша ПРОБЕЛ мгновенно глушит моторы" FontSize="12" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,24,0,16" FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- Поиск геймпада и журнал подключения -->
                            <Border Grid.Row="1" Background="#12141A" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="ПОИСК ГЕЙМПАДА (HID)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                                    <TextBlock Text="Если стоит HidHide/DS4Windows — устройства скрыты из обычного перечисления; поиск читает реестр и открывает устройства напрямую."
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <ItemsControl ItemsSource="{Binding Control.GamepadDevices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#151821" CornerRadius="6" Padding="10" Margin="0,0,0,6"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Display}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Path}" FontSize="9" FontFamily="Consolas"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Подключить" Style="{StaticResource ModernButton}" FontSize="11" Padding="10,4"
                                                                Command="{Binding DataContext.Control.ConnectGamepadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Path}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="ЖУРНАЛ ПОДКЛЮЧЕНИЯ" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4" />
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="140">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Control.GamepadLog}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="6,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 4. WI-FI СЕТИ -->
            <TabItem Header="📶 Wi-Fi сети">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,14" Background="#151821">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="РЕЖИМ WI-FI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Wifi.CurrentMode}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="АКТИВНАЯ СЕТЬ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Wifi.CurrentSsid}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IP-АДРЕС РОБОТА" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Wifi.CurrentIp}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="ИЗВЕСТНЫЕ СЕТИ В РОБОТЕ" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Content="🔄 Обновить" Style="{StaticResource SecondaryButton}" Command="{Binding Wifi.RefreshListCommand}" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Wifi.Networks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#151821" CornerRadius="8" Padding="14" Margin="0,0,0,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Ssid}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                                <Border Background="#163828" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="● АКТИВНО" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Priority, StringFormat={}Приоритет: {0}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                                        </StackPanel>

                                                        <Button Grid.Column="2" Content="Удалить" Style="{StaticResource DangerButton}" FontSize="12" Padding="12,6"
                                                                Command="{Binding DataContext.Wifi.DeleteNetworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Ssid}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="ДОБАВИТЬ СЕТЬ" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16" />

                                <TextBlock Text="Имя сети (SSID)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Wifi.NewSsid}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" />

                                <TextBlock Text="Пароль WPA2" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Wifi.NewPassword}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" />

                                <TextBlock Text="Приоритет (чем выше, тем раньше подключается)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Wifi.NewPriority}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,24" />

                                <Button Content="➕ Добавить в память робота" Style="{StaticResource SuccessButton}" Command="{Binding Wifi.AddNetworkCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                                <TextBlock Text="{Binding Wifi.StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 5. АНАЛИЗ ЧЁРНОГО ЯЩИКА -->
            <TabItem Header="📦 Анализ аварий (Чёрный ящик)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BlackBox.StatusMessage}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Запись последних 2 секунд на частоте 200 Гц до удара о пол" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="🗑 Очистить ящик" Style="{StaticResource SecondaryButton}" Command="{Binding BlackBox.ClearBlackBoxCommand}" Margin="0,0,8,0" />
                                <Button Content="📥 Выгрузить и разобрать аварию" Style="{StaticResource ModernButton}" Command="{Binding BlackBox.LoadBlackBoxCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="4">
                        <ScottPlot:WpfPlot x:Name="PlotBlackBox" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- 6. АНАЛИЗ УСТОЙЧИВОСТИ (BODE) -->
            <TabItem Header="📊 Устойчивость (Bode)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Панель управления тестом -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Bode.StatusMessage}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Тест подаёт короткий импульс трима и записывает отклик угла: АЧХ/ФЧХ через БПФ, запасы по фазе и усилению."
                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="Амплитуда импульса" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Minimum="0.3" Maximum="3.0" Value="{Binding Bode.PulseAmplitude}"
                                                SmallChange="0.1" LargeChange="0.5" Width="110" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Bode.PulseAmplitude, StringFormat={}{0:F1}°}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Content="▶ Запустить тест" Style="{StaticResource ModernButton}" FontSize="13"
                                        Command="{Binding Bode.RunTestCommand}" Visibility="{Binding Bode.IsRunning, Converter={StaticResource InverseBoolToVis}}"
                                        Margin="0,0,8,0" Padding="16,10" />
                                <Button Content="⏹ Прервать" Style="{StaticResource DangerButton}" FontSize="13"
                                        Command="{Binding Bode.StopTestCommand}" Visibility="{Binding Bode.IsRunning, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,8,0" Padding="16,10" />
                                <Button Content="💾 Экспорт CSV" Style="{StaticResource SecondaryButton}" FontSize="13"
                                        Command="{Binding Bode.ExportCsvCommand}" IsEnabled="{Binding Bode.HasResult}" Padding="14,10" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Запасы устойчивости + графики -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Карточки запасов -->
                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="ЗАПАС ПО УСИЛЕНИЮ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Bode.GainMarginText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardPanel}" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="ЗАПАС ПО ФАЗЕ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Bode.PhaseMarginText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardPanel}" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="ЧАСТОТА СРЕЗА" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Bode.CrossoverText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardPanel}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="РЕЗОНАНС |T|" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Bode.PeakText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Графики: отклик + АЧХ + ФЧХ -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,6,0" Padding="4">
                                <ScottPlot:WpfPlot x:Name="PlotStepResponse" />
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="3,0,3,0" Padding="4">
                                <ScottPlot:WpfPlot x:Name="PlotBodeMag" />
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Margin="6,0,0,0" Padding="4">
                                <ScottPlot:WpfPlot x:Name="PlotBodePhase" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>