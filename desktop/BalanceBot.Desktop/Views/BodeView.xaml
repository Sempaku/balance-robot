<UserControl x:Class="BalanceBot.Desktop.Views.BodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:BalanceBot.Desktop.Controls"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель управления тестом с улучшенным оформлением -->
        <Border Grid.Row="0" 
                Background="{DynamicResource Primary700Brush}"
                BorderBrush="{DynamicResource Primary500Brush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,14">
            <WrapPanel Margin="16">
                <StackPanel MinWidth="240" MaxWidth="520" VerticalAlignment="Center" Margin="0,4,24,4">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent500Brush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Тест подаёт короткий импульс трима и записывает отклик угла: АЧХ/ФЧХ через БПФ, запасы по фазе и усилению."
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextLowEmphasisBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Амплитуда импульса"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextLowEmphasisBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="0.3" Maximum="3.0"
                                    Value="{Binding PulseAmplitude}"
                                    SmallChange="0.1" LargeChange="0.5"
                                    IsMoveToPointEnabled="True"
                                    Width="120"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ModernSlider}" />
                            <TextBlock Text="{Binding PulseAmplitude, StringFormat={}{0:F1}°}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Warning500Brush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Button Content="&#xE768; Запустить тест"
                            Style="{StaticResource ModernButton}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Command="{Binding RunTestCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}"
                            Margin="0,0,10,0"
                            Padding="18,12" />
                    <Button Content="&#xE71A; Прервать"
                            Style="{StaticResource DangerButton}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Command="{Binding StopTestCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,10,0"
                            Padding="18,12" />
                    <Button Content="&#xE74E; Экспорт CSV"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="{DynamicResource FontSizeCaption}"
                            Command="{Binding ExportCsvCommand}"
                            IsEnabled="{Binding HasResult}"
                            Padding="16,12" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Запасы + графики -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Карточки запасов: адаптивные -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,14">
                <ctrl:MetricCard Title="Запас по усилению"
                                 ValueContent="{Binding GainMarginText}"
                                 ValueForeground="{DynamicResource Success500Brush}"
                                 MinWidth="170" 
                                 Margin="0,0,8,8" />
                <ctrl:MetricCard Title="Запас по фазе"
                                 ValueContent="{Binding PhaseMarginText}"
                                 ValueForeground="{DynamicResource Success500Brush}"
                                 MinWidth="170" 
                                 Margin="0,0,8,8" />
                <ctrl:MetricCard Title="Частота среза"
                                 ValueContent="{Binding CrossoverText}"
                                 ValueForeground="{DynamicResource Accent500Brush}"
                                 MinWidth="170" 
                                 Margin="0,0,8,8" />
                <ctrl:MetricCard Title="Резонанс |T|"
                                 ValueContent="{Binding PeakText}"
                                 ValueForeground="{DynamicResource Warning500Brush}"
                                 MinWidth="170" 
                                 Margin="0,0,0,8" />
            </WrapPanel>

            <!-- Графики: адаптивная сетка с улучшенным оформлением -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <UniformGrid Columns="1">
                    <Border Background="{DynamicResource Primary700Brush}"
                            BorderBrush="{DynamicResource Primary500Brush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,10" 
                            Padding="6" 
                            MinHeight="260">
                        <Grid>
                            <ScottPlot:WpfPlot x:Name="PlotStepResponse" />
                            <TextBlock Text="Отклик на импульс трима"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextMediumEmphasisBrush}"
                                       HorizontalAlignment="Left" 
                                       VerticalAlignment="Top"
                                       Margin="10,6,0,0" />
                        </Grid>
                    </Border>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="{DynamicResource Primary700Brush}"
                                BorderBrush="{DynamicResource Primary500Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,5,0" 
                                Padding="6" 
                                MinHeight="260">
                            <Grid>
                                <ScottPlot:WpfPlot x:Name="PlotBodeMag" />
                                <TextBlock Text="АЧХ контура |L| (дБ)"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextMediumEmphasisBrush}"
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Top"
                                           Margin="10,6,0,0" />
                            </Grid>
                        </Border>
                        
                        <Border Grid.Column="1" 
                                Background="{DynamicResource Primary700Brush}"
                                BorderBrush="{DynamicResource Primary500Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="5,0,0,0" 
                                Padding="6" 
                                MinHeight="260">
                            <Grid>
                                <ScottPlot:WpfPlot x:Name="PlotBodePhase" />
                                <TextBlock Text="ФЧХ контура ∠L (°)"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextMediumEmphasisBrush}"
                                           HorizontalAlignment="Left" 
                                           VerticalAlignment="Top"
                                           Margin="10,6,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </UniformGrid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
