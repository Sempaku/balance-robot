<UserControl x:Class="BalanceBot.Desktop.Views.BlackBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель управления с улучшенным оформлением -->
        <Border Grid.Row="0" 
                Background="{DynamicResource Primary700Brush}"
                BorderBrush="{DynamicResource Primary500Brush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,14">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent500Brush}" />
                    <TextBlock Text="Запись последних 2 секунд на частоте 200 Гц до удара о пол"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextLowEmphasisBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#xE74C; Очистить ящик"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearBlackBoxCommand}"
                            Margin="0,0,10,0" 
                            Padding="14,10" />
                    <Button Content="&#xE896; Выгрузить и разобрать аварию"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding LoadBlackBoxCommand}" 
                            Padding="14,10" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- График с улучшенным оформлением -->
        <Border Grid.Row="1" 
                Background="{DynamicResource Primary700Brush}"
                BorderBrush="{DynamicResource Primary500Brush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
            <Grid>
                <ScottPlot:WpfPlot x:Name="PlotBlackBox" />
                <TextBlock Text="Чёрный ящик падений"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextMediumEmphasisBrush}"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top"
                           Margin="10,6,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
