<UserControl x:Class="BalanceBot.Desktop.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Пропорциональные колонки: Grid сжимает их вместо наложения друг на друга -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.6*" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель с улучшенным оформлением -->
        <Border Grid.Column="0" 
                Background="{DynamicResource Primary700Brush}"
                BorderBrush="{DynamicResource Primary500Brush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="Пульт управления"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent500Brush}"
                               Margin="0,0,0,18" />

                    <!-- Клавиатура -->
                    <Border Background="{DynamicResource Primary600Brush}"
                            CornerRadius="8"
                            Padding="16" 
                            Margin="0,0,0,22"
                            BorderBrush="{DynamicResource Primary500Brush}" 
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Управление клавиатурой"
                                           FontWeight="SemiBold"
                                           FontSize="{DynamicResource FontSizeBody}" />
                                <TextBlock Text="WASD или стрелки"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsKeyboardActive}"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ModernCheckBox}" />
                        </Grid>
                    </Border>

                    <!-- Геймпад -->
                    <Border Background="{DynamicResource Primary600Brush}"
                            CornerRadius="8"
                            Padding="16" 
                            Margin="0,0,0,22"
                            BorderBrush="{DynamicResource Primary500Brush}" 
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Геймпад DualSense (USB / Bluetooth)"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource FontSizeBody}" />
                                    <TextBlock Text="{Binding GamepadStatusText}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextLowEmphasisBrush}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsGamepadActive}"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernCheckBox}" />
                            </Grid>
                            <TextBlock Text="X — баланс, O — стоп, PS — аварийный стоп, R2 — форсаж, D-pad — трим и тяга"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextLowEmphasisBrush}"
                                       TextWrapping="Wrap" 
                                       Margin="0,8,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="&#xE72C; Поиск"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Padding="12,6"
                                        Command="{Binding RescanGamepadsCommand}"
                                        Margin="0,4,8,4" />
                                <Button Content="&#xE713; Авто"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Padding="12,6"
                                        Command="{Binding UseAutoGamepadCommand}"
                                        Margin="0,4,8,4"
                                        ToolTip="Вернуться к автопоиску DualSense" />
                                <Button Content="&#xE7F6; Тест"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="{DynamicResource FontSizeCaption}"
                                        Padding="12,6"
                                        Command="{Binding TestRumbleCommand}"
                                        Margin="0,4,0,4"
                                        ToolTip="Тест вибрации и lightbar" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Ограничение тяги -->
                    <TextBlock Text="Ограничение тяги хода"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMediumEmphasisBrush}" 
                               Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="0.1" Maximum="1.0"
                                Value="{Binding SpeedScale}"
                                SmallChange="0.05" LargeChange="0.1"
                                VerticalAlignment="Center"
                                Style="{StaticResource ModernSlider}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SpeedScale, StringFormat={}{0:P0}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextHighEmphasisBrush}" />
                    </Grid>

                    <!-- Чувствительность -->
                    <TextBlock Text="Чувствительность разворота"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMediumEmphasisBrush}" 
                               Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="0.1" Maximum="1.0"
                                Value="{Binding TurnScale}"
                                SmallChange="0.05" LargeChange="0.1"
                                VerticalAlignment="Center"
                                Style="{StaticResource ModernSlider}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TurnScale, StringFormat={}{0:P0}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextHighEmphasisBrush}" />
                    </Grid>

                    <!-- Текущий выход -->
                    <Border Background="{DynamicResource Primary600Brush}"
                            CornerRadius="8"
                            Padding="16"
                            BorderBrush="{DynamicResource Primary500Brush}" 
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Текущий выход в UDP (Watchdog 300ms)"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextLowEmphasisBrush}" />
                            <TextBlock Text="{Binding CurrentForward, StringFormat={}Forward: {0:+0.00;-0.00;0.00}}"
                                       FontSize="{DynamicResource FontSizeTitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Success500Brush}"
                                       Margin="0,8,0,4" />
                            <TextBlock Text="{Binding CurrentTurn, StringFormat={}Turn:    {0:+0.00;-0.00;0.00}}"
                                       FontSize="{DynamicResource FontSizeTitle}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Warning500Brush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Правая панель с улучшенным оформлением -->
        <Border Grid.Column="1" 
                Background="{DynamicResource Primary700Brush}"
                BorderBrush="{DynamicResource Primary500Brush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Раскладка клавиатуры -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock Text="Раскладка клавиатуры"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextLowEmphasisBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,26" />

                        <Viewbox MaxWidth="340" MaxHeight="300" Stretch="Uniform">
                            <Grid Width="300" Height="260">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="80" />
                                    <RowDefinition Height="80" />
                                    <RowDefinition Height="80" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{DynamicResource Primary600Brush}"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource Primary500Brush}" 
                                        BorderThickness="2"
                                        Margin="4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70E;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource Accent500Brush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="W"
                                                   FontSize="28" 
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextHighEmphasisBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Вперёд"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextLowEmphasisBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0"
                                        Background="{DynamicResource Primary600Brush}"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource Primary500Brush}" 
                                        BorderThickness="2"
                                        Margin="4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70E;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource Accent500Brush}"
                                                   HorizontalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="A"
                                                   FontSize="28" 
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextHighEmphasisBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Влево"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextLowEmphasisBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1"
                                        Background="{DynamicResource Primary600Brush}"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource Primary500Brush}" 
                                        BorderThickness="2"
                                        Margin="4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70E;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource Accent500Brush}"
                                                   HorizontalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="180" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="S"
                                                   FontSize="28" 
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextHighEmphasisBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Назад"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextLowEmphasisBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="2"
                                        Background="{DynamicResource Primary600Brush}"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource Primary500Brush}" 
                                        BorderThickness="2"
                                        Margin="4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70E;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource Accent500Brush}"
                                                   HorizontalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="D"
                                                   FontSize="28" 
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextHighEmphasisBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Вправо"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextLowEmphasisBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Viewbox>

                        <TextBlock Text="Клавиша ПРОБЕЛ мгновенно глушит моторы"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource Danger500Brush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,26,0,18"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Раскладка геймпада -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource Primary600Brush}"
                            CornerRadius="8"
                            Padding="16" 
                            Margin="0,0,0,14"
                            BorderBrush="{DynamicResource Primary500Brush}" 
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="&#xE7FC; Раскладка геймпада (DualSense)"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Accent500Brush}"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Левый стик"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMediumEmphasisBrush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Ход вперёд / назад"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" 
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Правый стик"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMediumEmphasisBrush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Разворот на месте"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="R2 (удерживать)"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMediumEmphasisBrush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Форсаж: добавляет тягу до 100%"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" 
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="X (крест)"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Success500Brush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Включить баланс"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="O (круг)"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Warning500Brush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Выключить баланс (стоп)"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="PS"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Danger500Brush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Аварийный стоп — работает всегда"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" 
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="D-pad"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMediumEmphasisBrush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Трим и ограничение тяги"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" 
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Create"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMediumEmphasisBrush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="Вкл / выкл управление с геймпада"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Lightbar"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMediumEmphasisBrush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="Цветной индикатор состояния"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" 
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Вибрация"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMediumEmphasisBrush}" 
                                           Margin="0,3" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="Импульс — упал/стоп, нарастающая — приближение к падению"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}" 
                                           Margin="0,3" 
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="Не задействованы: треугольник, квадрат, L1, R1, L2, L3, R3, options, тачпад"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}"
                                           Margin="0,8,0,0" 
                                           Opacity="0.7" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Поиск геймпада -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource Primary600Brush}"
                            CornerRadius="8"
                            Padding="16" 
                            Margin="0,0,0,14"
                            BorderBrush="{DynamicResource Primary500Brush}" 
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Поиск геймпада (HID)"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Accent500Brush}"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="Если стоит HidHide/DS4Windows — устройства скрыты из обычного перечисления; поиск читает реестр и открывает устройства напрямую."
                                       FontSize="10"
                                       Foreground="{DynamicResource TextLowEmphasisBrush}"
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,12" />

                            <ItemsControl ItemsSource="{Binding GamepadDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Primary700Brush}"
                                                CornerRadius="6"
                                                Padding="12" 
                                                Margin="0,0,0,8"
                                                BorderBrush="{DynamicResource Primary500Brush}" 
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Display}"
                                                               FontSize="{DynamicResource FontSizeCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextMediumEmphasisBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Path}"
                                                               FontSize="9" 
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextLowEmphasisBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Подключить"
                                                        Style="{StaticResource ModernButton}"
                                                        FontSize="{DynamicResource FontSizeCaption}"
                                                        Padding="12,6"
                                                        Command="{Binding DataContext.ConnectGamepadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Path}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Журнал подключения"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextLowEmphasisBrush}"
                                       Margin="0,12,0,6" />
                            <Border BorderBrush="{DynamicResource Primary500Brush}" 
                                    BorderThickness="1"
                                    CornerRadius="6" 
                                    MaxHeight="160">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GamepadLog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="10" 
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextLowEmphasisBrush}"
                                                           Margin="6,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
