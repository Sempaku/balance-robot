<UserControl x:Class="BalanceBot.Desktop.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" MaxWidth="480" />
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Пульт управления"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,16" />

                    <!-- Клавиатура -->
                    <Border Background="{StaticResource BgDarkBrush}"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="14" Margin="0,0,0,20"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Управление клавиатурой"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource FontSizeBody}" />
                                <TextBlock Text="WASD или стрелки"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsKeyboardActive}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Геймпад -->
                    <Border Background="{StaticResource BgDarkBrush}"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="14" Margin="0,0,0,20"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Геймпад DualSense (USB / Bluetooth)"
                                               FontWeight="SemiBold"
                                               FontSize="{StaticResource FontSizeBody}" />
                                    <TextBlock Text="{Binding GamepadStatusText}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsGamepadActive}"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="X — баланс, O — стоп, PS — аварийный стоп, R2 — форсаж, D-pad — трим и тяга"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="&#xE72C; Поиск"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Padding="10,5"
                                        Command="{Binding RescanGamepadsCommand}"
                                        Margin="0,0,6,0" />
                                <Button Content="&#xE713; Авто"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Padding="10,5"
                                        Command="{Binding UseAutoGamepadCommand}"
                                        Margin="0,0,6,0"
                                        ToolTip="Вернуться к автопоиску DualSense" />
                                <Button Content="&#xE7F6; Тест"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Padding="10,5"
                                        Command="{Binding TestRumbleCommand}"
                                        ToolTip="Тест вибрации и lightbar" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Ограничение тяги -->
                    <TextBlock Text="Ограничение тяги хода"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="0.1" Maximum="1.0"
                                Value="{Binding SpeedScale}"
                                SmallChange="0.05" LargeChange="0.1"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SpeedScale, StringFormat={}{0:P0}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold" />
                    </Grid>

                    <!-- Чувствительность -->
                    <TextBlock Text="Чувствительность разворота"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Grid Margin="0,4,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Minimum="0.1" Maximum="1.0"
                                Value="{Binding TurnScale}"
                                SmallChange="0.05" LargeChange="0.1"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TurnScale, StringFormat={}{0:P0}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold" />
                    </Grid>

                    <!-- Текущий выход -->
                    <Border Background="{StaticResource BgDarkBrush}"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Текущий выход в UDP (Watchdog 300ms)"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CurrentForward, StringFormat={}Forward: {0:+0.00;-0.00;0.00}}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,6,0,2" />
                            <TextBlock Text="{Binding CurrentTurn, StringFormat={}Turn:    {0:+0.00;-0.00;0.00}}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Правая панель -->
        <Border Grid.Column="1" Style="{StaticResource CardPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Раскладка клавиатуры -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Text="Раскладка клавиатуры"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24" />

                        <Viewbox MaxWidth="320" MaxHeight="280" Stretch="Uniform">
                            <Grid Width="300" Height="260">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="80" />
                                    <RowDefinition Height="80" />
                                    <RowDefinition Height="80" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSmall}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                        Margin="4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70E;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="W"
                                                   FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Вперёд"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0"
                                        Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSmall}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                        Margin="4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70E;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="A"
                                                   FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Влево"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1"
                                        Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSmall}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                        Margin="4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70E;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="180" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="S"
                                                   FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Назад"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="2"
                                        Background="{StaticResource BgDarkBrush}"
                                        CornerRadius="{StaticResource CornerRadiusSmall}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                        Margin="4">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70E;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="D"
                                                   FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Вправо"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Viewbox>

                        <TextBlock Text="Клавиша ПРОБЕЛ мгновенно глушит моторы"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource DangerBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,24,0,16"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Раскладка геймпада -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgDarkBrush}"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="14" Margin="0,0,0,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="&#xE7FC; Раскладка геймпада (DualSense)"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Левый стик"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Ход вперёд / назад"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Правый стик"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Разворот на месте"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="R2 (удерживать)"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Форсаж: добавляет тягу до 100%"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="X (крест)"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Включить баланс"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="O (круг)"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Выключить баланс (стоп)"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="PS"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Аварийный стоп — работает всегда"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="D-pad"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Трим и ограничение тяги"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Create"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="Вкл / выкл управление с геймпада"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Lightbar"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="Цветной индикатор состояния"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Вибрация"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="Импульс — упал/стоп, нарастающая — приближение к падению"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="Не задействованы: треугольник, квадрат, L1, R1, L2, L3, R3, options, тачпад"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,6,0,0" Opacity="0.7" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Поиск геймпада -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BgDarkBrush}"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="14" Margin="0,0,0,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Поиск геймпада (HID)"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Если стоит HidHide/DS4Windows — устройства скрыты из обычного перечисления; поиск читает реестр и открывает устройства напрямую."
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />

                            <ItemsControl ItemsSource="{Binding GamepadDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCardBrush}"
                                                CornerRadius="{StaticResource CornerRadiusSmall}"
                                                Padding="10" Margin="0,0,0,6"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Display}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Path}"
                                                               FontSize="9" FontFamily="Consolas"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Подключить"
                                                        Style="{StaticResource ModernButton}"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Padding="10,4"
                                                        Command="{Binding DataContext.ConnectGamepadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Path}"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Журнал подключения"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,10,0,4" />
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CornerRadiusSmall}" MaxHeight="140">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GamepadLog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="10" FontFamily="Consolas"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="6,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
