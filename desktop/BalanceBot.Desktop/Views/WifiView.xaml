<UserControl x:Class="BalanceBot.Desktop.Views.WifiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Статус: адаптивный -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,14" Background="{StaticResource BgDarkBrush}">
            <WrapPanel>
                <StackPanel MinWidth="180" Margin="0,0,24,0">
                    <TextBlock Text="Режим Wi-Fi"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding CurrentMode}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel MinWidth="180" Margin="0,0,24,0">
                    <TextBlock Text="Активная сеть"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding CurrentSsid}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel MinWidth="180">
                    <TextBlock Text="IP-адрес робота"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding CurrentIp}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Список сетей + добавление -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Список сетей -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Известные сети в роботе"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <Button Content="&#xE72C; Обновить"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshListCommand}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Networks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgDarkBrush}"
                                            CornerRadius="{StaticResource CornerRadiusSmall}"
                                            Padding="14" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Ssid}"
                                                               FontSize="{StaticResource FontSizeBody}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <Border Background="#163828"
                                                            CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                                            BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="&#xE73D; Активно"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource SuccessBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Priority, StringFormat={}Приоритет: {0}}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Удалить"
                                                    Style="{StaticResource DangerButton}"
                                                    FontSize="{StaticResource FontSizeCaption}"
                                                    Padding="12,6"
                                                    Command="{Binding DataContext.DeleteNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Ssid}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Добавление сети -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}" MinWidth="300" MaxWidth="380">
                <StackPanel>
                    <TextBlock Text="Добавить сеть"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Имя сети (SSID)"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewSsid}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,14" />

                    <TextBlock Text="Пароль WPA2"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewPassword}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,14" />

                    <TextBlock Text="Приоритет (чем выше, тем раньше подключается)"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewPriority}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,24" />

                    <Button Content="&#xE710; Добавить в память робота"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddNetworkCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,16" />

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
