<UserControl x:Class="BalanceBot.Desktop.Views.WifiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Статус: адаптивный с улучшенным оформлением -->
        <Border Grid.Row="0" 
                Background="{DynamicResource Primary600Brush}"
                BorderBrush="{DynamicResource Primary500Brush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,16">
            <WrapPanel Margin="16">
                <StackPanel MinWidth="180" Margin="0,0,26,0">
                    <TextBlock Text="Режим Wi-Fi"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextLowEmphasisBrush}" />
                    <TextBlock Text="{Binding CurrentMode}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent500Brush}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel MinWidth="180" Margin="0,0,26,0">
                    <TextBlock Text="Активная сеть"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextLowEmphasisBrush}" />
                    <TextBlock Text="{Binding CurrentSsid}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Success500Brush}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel MinWidth="180">
                    <TextBlock Text="IP-адрес робота"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextLowEmphasisBrush}" />
                    <TextBlock Text="{Binding CurrentIp}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextHighEmphasisBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Список сетей + добавление: список сжимается, форма фиксированной ширины -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Список сетей с улучшенным оформлением -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Primary700Brush}"
                    BorderBrush="{DynamicResource Primary500Brush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,12,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="Известные сети в роботе"
                                   FontSize="{DynamicResource FontSizeTitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextHighEmphasisBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,18,0" />
                        <Button Content="&#xE72C; Обновить"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshListCommand}" 
                                Padding="12,8" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Networks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Primary600Brush}"
                                            CornerRadius="8"
                                            Padding="16" 
                                            Margin="0,0,0,10"
                                            BorderBrush="{DynamicResource Primary500Brush}" 
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Ssid}"
                                                               FontSize="{DynamicResource FontSizeBody}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Accent500Brush}" />
                                                    <Border Background="#163828"
                                                            CornerRadius="4" 
                                                            Padding="8,3" 
                                                            Margin="12,0,0,0"
                                                            BorderBrush="{DynamicResource Success500Brush}" 
                                                            BorderThickness="1"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="&#xE73D; Активно"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource Success500Brush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Priority, StringFormat={}Приоритет: {0}}"
                                                           FontSize="{DynamicResource FontSizeCaption}"
                                                           Foreground="{DynamicResource TextLowEmphasisBrush}"
                                                           Margin="0,6,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Удалить"
                                                    Style="{StaticResource DangerButton}"
                                                    FontSize="{DynamicResource FontSizeCaption}"
                                                    Padding="14,8"
                                                    Command="{Binding DataContext.DeleteNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Ssid}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Добавление сети с улучшенным оформлением -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Primary700Brush}"
                    BorderBrush="{DynamicResource Primary500Brush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Margin="16">
                    <TextBlock Text="Добавить сеть"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent500Brush}"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Имя сети (SSID)"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextLowEmphasisBrush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewSsid}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,16" />

                    <TextBlock Text="Пароль WPA2"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextLowEmphasisBrush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewPassword}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,16" />

                    <TextBlock Text="Приоритет (чем выше, тем раньше подключается)"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextLowEmphasisBrush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewPriority}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,26" />

                    <Button Content="&#xE710; Добавить в память робота"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding AddNetworkCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,18" 
                            Padding="14,10" />

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextLowEmphasisBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
