<UserControl x:Class="BalanceBot.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BalanceBot.Desktop"
             xmlns:ctrl="clr-namespace:BalanceBot.Desktop.Controls"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Метрики -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
            <ctrl:MetricCard Title="Состояние"
                             ValueContent="{Binding StateText}"
                             ValueForeground="{StaticResource AccentBrush}"
                             Margin="0,0,6,6" />
            <ctrl:MetricCard Title="Угол наклона"
                             ValueContent="{Binding Angle, StringFormat={}{0:F2}°}"
                             Margin="3,0,3,6" />
            <ctrl:MetricCard Title="Гироскоп"
                             ValueContent="{Binding Gyro, StringFormat={}{0:F1}°/с}"
                             Margin="3,0,3,6" />
            <ctrl:MetricCard Title="Тяга привода"
                             ValueContent="{Binding CmdRps, StringFormat={}{0:F2} об/с}"
                             ValueForeground="{StaticResource WarningBrush}"
                             Margin="3,0,3,6" />
            <ctrl:MetricCard Title="Скорость колес"
                             ValueContent="{Binding WheelRateRps, StringFormat={}{0:F2} об/с}"
                             Margin="0,6,6,0" />
            <ctrl:MetricCard Title="Наклон хода (Lean)"
                             ValueContent="{Binding Lean, StringFormat={}{0:+0.00;-0.00;0.00}°}"
                             ValueForeground="{StaticResource WarningBrush}"
                             Margin="3,6,3,0" />
            <ctrl:MetricCard Title="Трим (равновесие)"
                             ValueContent="{Binding Trim, StringFormat={}{0:+0.00;-0.00;0.00}°}"
                             ValueForeground="{StaticResource SuccessBrush}"
                             Margin="3,6,3,0" />
            <ctrl:MetricCard Title="Цикл / Ошибки IMU"
                             ValueContent="{Binding DtUs, StringFormat={}{0} мкс}"
                             ValueForeground="{StaticResource SuccessBrush}"
                             Margin="3,6,0,0" />
        </UniformGrid>

        <!-- Графики + боковая панель -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Графики -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="*" MinHeight="200" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,8" Padding="4">
                    <ScottPlot:WpfPlot x:Name="PlotOrientation" />
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,8,0,0" Padding="4">
                    <ScottPlot:WpfPlot x:Name="PlotMotors" />
                </Border>
            </Grid>

            <!-- Боковая панель -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}" MinWidth="280" MaxWidth="340">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Трим -->
                        <TextBlock Text="Точка равновесия (Трим)"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,6" />
                        <Border Background="{StaticResource BgDarkBrush}"
                                CornerRadius="{StaticResource CornerRadiusSmall}"
                                Padding="10" Margin="0,0,0,14"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Смещение угла:"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TrimOffset, StringFormat={}{0:+0.00;-0.00;0.00}°}"
                                               HorizontalAlignment="Right"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </Grid>

                                <Slider Minimum="-5.0" Maximum="5.0"
                                        Value="{Binding TrimOffset}"
                                        SmallChange="0.05" LargeChange="0.2"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="False"
                                        Margin="0,2,0,8" />

                                <UniformGrid Columns="5" Margin="0,2,0,0">
                                    <Button Content="-0.2°" Style="{StaticResource SecondaryButton}"
                                            Padding="4,4" FontSize="11"
                                            Command="{Binding AdjustTrimCommand}" CommandParameter="-0.2" Margin="1" />
                                    <Button Content="-0.05°" Style="{StaticResource SecondaryButton}"
                                            Padding="2,4" FontSize="10"
                                            Command="{Binding AdjustTrimCommand}" CommandParameter="-0.05" Margin="1" />
                                    <Button Content="0.0°" Style="{StaticResource SecondaryButton}"
                                            Padding="4,4" FontSize="11"
                                            Command="{Binding ResetTrimCommand}" Margin="1" />
                                    <Button Content="+0.05°" Style="{StaticResource SecondaryButton}"
                                            Padding="2,4" FontSize="10"
                                            Command="{Binding AdjustTrimCommand}" CommandParameter="0.05" Margin="1" />
                                    <Button Content="+0.2°" Style="{StaticResource SecondaryButton}"
                                            Padding="4,4" FontSize="11"
                                            Command="{Binding AdjustTrimCommand}" CommandParameter="0.2" Margin="1" />
                                </UniformGrid>
                                <TextBlock Text="Подстройка: клавиши [ и ]"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Управление графиком -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding PauseButtonText}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TogglePauseCommand}"
                                    Margin="0,0,4,0" />
                            <Button Grid.Column="1"
                                    Content="&#xE72C; Масштаб"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ResetAxesCommand}"
                                    Margin="4,0,0,0" />
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />

                        <!-- Каналы ориентации -->
                        <TextBlock Text="Ориентация и датчики"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />

                        <ctrl:ChannelToggle IsChecked="{Binding ShowAngle}"
                                            Label="Угол фильтра (°)"
                                            ChannelColor="#3D7EFF" />
                        <ctrl:ChannelToggle IsChecked="{Binding ShowGyro}"
                                            Label="Гироскоп (°/с)"
                                            ChannelColor="#00E676" />
                        <ctrl:ChannelToggle IsChecked="{Binding ShowTrim}"
                                            Label="Точка баланса Trim (°)"
                                            ChannelColor="#E8EAF0" />
                        <ctrl:ChannelToggle IsChecked="{Binding ShowAccelAngle}"
                                            Label="Сырой акселерометр (°)"
                                            ChannelColor="#80D8FF" />
                        <ctrl:ChannelToggle IsChecked="{Binding ShowLean}"
                                            Label="Целевой наклон Lean (°)"
                                            ChannelColor="#FF6D00" />

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />

                        <!-- Каналы моторов -->
                        <TextBlock Text="Моторы и контур (об/с)"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />

                        <ctrl:ChannelToggle IsChecked="{Binding ShowCmd}"
                                            Label="Команда привода (об/с)"
                                            ChannelColor="#FFB300" />
                        <ctrl:ChannelToggle IsChecked="{Binding ShowWheelRate}"
                                            Label="Скорость колес (об/с)"
                                            ChannelColor="#B388FF" />
                        <ctrl:ChannelToggle IsChecked="{Binding ShowTermP}"
                                            Label="Вклад P-члена"
                                            ChannelColor="#FF4081" />
                        <ctrl:ChannelToggle IsChecked="{Binding ShowTermD}"
                                            Label="Вклад D-члена"
                                            ChannelColor="#78909C" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
