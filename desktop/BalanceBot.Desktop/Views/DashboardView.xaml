<UserControl x:Class="BalanceBot.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BalanceBot.Desktop"
             xmlns:ctrl="clr-namespace:BalanceBot.Desktop.Controls"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Wide">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SidebarColumn" Storyboard.TargetProperty="Width">
                            <DiscreteObjectKeyFrame KeyTime="0">
                                <DiscreteObjectKeyFrame.Value>
                                    <GridLength>300</GridLength>
                                </DiscreteObjectKeyFrame.Value>
                            </DiscreteObjectKeyFrame>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SidebarBorder" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SidebarColumn" Storyboard.TargetProperty="Width">
                            <DiscreteObjectKeyFrame KeyTime="0">
                                <DiscreteObjectKeyFrame.Value>
                                    <GridLength>0</GridLength>
                                </DiscreteObjectKeyFrame.Value>
                            </DiscreteObjectKeyFrame>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SidebarBorder" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToggleSidebarButton" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Улучшенные метрики: адаптивная сетка -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- Основные метрики -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                <ctrl:MetricCard Title="Состояние"
                                 ValueContent="{Binding StateText}"
                                 ValueForeground="{DynamicResource Accent500Brush}"
                                 MinWidth="140" Margin="0,0,6,6" />
                <ctrl:MetricCard Title="Угол наклона"
                                 ValueContent="{Binding Angle, StringFormat={}{0:F2}°}"
                                 MinWidth="140" Margin="0,0,6,6" />
                <ctrl:MetricCard Title="Гироскоп"
                                 ValueContent="{Binding Gyro, StringFormat={}{0:F1}°/с}"
                                 MinWidth="140" Margin="0,0,6,6" />
                <ctrl:MetricCard Title="Тяга привода"
                                 ValueContent="{Binding CmdRps, StringFormat={}{0:F2} об/с}"
                                 ValueForeground="{DynamicResource Warning500Brush}"
                                 MinWidth="140" Margin="0,0,6,6" />
                <ctrl:MetricCard Title="Скорость колес"
                                 ValueContent="{Binding WheelRateRps, StringFormat={}{0:F2} об/с}"
                                 MinWidth="140" Margin="0,0,0,6" />
            </WrapPanel>
            
            <!-- Дополнительные метрики -->
            <WrapPanel Grid.Row="1">
                <ctrl:MetricCard Title="Наклон хода"
                                 ValueContent="{Binding Lean, StringFormat={}{0:+0.00;-0.00;0.00}°}"
                                 ValueForeground="{DynamicResource Warning500Brush}"
                                 MinWidth="140" Margin="0,0,6,6" />
                <ctrl:MetricCard Title="Трим"
                                 ValueContent="{Binding Trim, StringFormat={}{0:+0.00;-0.00;0.00}°}"
                                 ValueForeground="{DynamicResource Success500Brush}"
                                 MinWidth="140" Margin="0,0,6,6" />
                <ctrl:MetricCard Title="Цикл"
                                 ValueContent="{Binding DtUs, StringFormat={}{0} мкс}"
                                 ValueForeground="{DynamicResource Success500Brush}"
                                 MinWidth="140" Margin="0,0,6,6" />
                <ctrl:MetricCard Title="Ошибки IMU"
                                 ValueContent="{Binding ImuErrors}"
                                 ValueForeground="{DynamicResource Danger500Brush}"
                                 MinWidth="140" Margin="0,0,6,6" />
                <ctrl:MetricCard Title="RSSI Wi-Fi"
                                 ValueContent="{Binding WifiRssi, StringFormat={}{0} dBm}"
                                 MinWidth="140" Margin="0,0,6,6" />
                <ctrl:MetricCard Title="Uptime"
                                 ValueContent="{Binding UptimeSec, StringFormat={}{0} с}"
                                 MinWidth="140" Margin="0,0,0,6" />
            </WrapPanel>
        </Grid>

        <!-- Улучшенные графики + боковая панель -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition x:Name="SidebarColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Графики с улучшенным оформлением -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="*" MinHeight="200" />
                </Grid.RowDefinitions>

                <!-- Кнопка показа боковой панели на узких экранах -->
                <Button x:Name="ToggleSidebarButton"
                        Content="&#xE700;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Style="{StaticResource SecondaryButton}"
                        Width="36" Height="36"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,8,0"
                        Visibility="Collapsed"
                        Click="ToggleSidebar_Click"
                        Panel.ZIndex="10" />

                <Border Grid.Row="0" 
                        Background="{DynamicResource Primary700Brush}"
                        BorderBrush="{DynamicResource Primary500Brush}" 
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,8" 
                        Padding="6">
                    <Grid>
                        <ScottPlot:WpfPlot x:Name="PlotOrientation" />
                        <TextBlock Text="Ориентация и IMU (Градусы °)"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMediumEmphasisBrush}"
                                   HorizontalAlignment="Left" 
                                   VerticalAlignment="Top"
                                   Margin="10,6,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" 
                        Background="{DynamicResource Primary700Brush}"
                        BorderBrush="{DynamicResource Primary500Brush}" 
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,8,0,0" 
                        Padding="6">
                    <Grid>
                        <ScottPlot:WpfPlot x:Name="PlotMotors" />
                        <TextBlock Text="Привод колес и регулятор (об/с)"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextMediumEmphasisBrush}"
                                   HorizontalAlignment="Left" 
                                   VerticalAlignment="Top"
                                   Margin="10,6,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Улучшенная боковая панель -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="1"
                    Background="{DynamicResource Primary700Brush}"
                    BorderBrush="{DynamicResource Primary500Brush}" 
                    BorderThickness="1"
                    CornerRadius="8"
                    MinWidth="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Кнопка скрытия панели -->
                        <Button Content="&#xE711;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Style="{StaticResource SecondaryButton}"
                                Width="32" Height="32"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,12"
                                Click="ToggleSidebar_Click" />

                        <!-- Трим с улучшенным оформлением -->
                        <TextBlock Text="Точка равновесия (Трим)"
                                   FontSize="{DynamicResource FontSizeTitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Accent500Brush}"
                                   Margin="0,0,0,12" />
                        
                        <Border Background="{DynamicResource Primary600Brush}"
                                CornerRadius="8"
                                Padding="12" Margin="0,0,0,16"
                                BorderBrush="{DynamicResource Primary500Brush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Смещение угла:"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               Foreground="{DynamicResource TextMediumEmphasisBrush}" />
                                    <TextBlock Text="{Binding TrimOffset, StringFormat={}{0:+0.00;-0.00;0.00}°}"
                                               HorizontalAlignment="Right"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Success500Brush}" />
                                </Grid>

                                <Slider Minimum="-8.0" Maximum="8.0"
                                        Value="{Binding TrimOffset}"
                                        SmallChange="0.05" LargeChange="0.2"
                                        IsMoveToPointEnabled="True"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="False"
                                        Margin="0,4,0,12" 
                                        Style="{StaticResource ModernSlider}" />

                                <UniformGrid Columns="5" Margin="0,4,0,0">
                                    <Button Content="-0.2°" 
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="4,6" 
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Command="{Binding AdjustTrimCommand}" 
                                            CommandParameter="-0.2" 
                                            Margin="2" />
                                    <Button Content="-0.05°" 
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="2,6" 
                                            FontSize="10"
                                            Command="{Binding AdjustTrimCommand}" 
                                            CommandParameter="-0.05" 
                                            Margin="2" />
                                    <Button Content="0.0°" 
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="4,6" 
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Command="{Binding ResetTrimCommand}" 
                                            Margin="2" />
                                    <Button Content="+0.05°" 
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="2,6" 
                                            FontSize="10"
                                            Command="{Binding AdjustTrimCommand}" 
                                            CommandParameter="0.05" 
                                            Margin="2" />
                                    <Button Content="+0.2°" 
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="4,6" 
                                            FontSize="{DynamicResource FontSizeCaption}"
                                            Command="{Binding AdjustTrimCommand}" 
                                            CommandParameter="0.2" 
                                            Margin="2" />
                                </UniformGrid>
                                
                                <TextBlock Text="Подстройка: клавиши [ и ]"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextLowEmphasisBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Управление графиком -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding PauseButtonText}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TogglePauseCommand}"
                                    Margin="0,0,4,0" 
                                    Padding="12,8" />
                            <Button Grid.Column="1"
                                    Content="&#xE72C; Масштаб"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ResetAxesCommand}"
                                    Margin="4,0,0,0" 
                                    Padding="12,8" />
                        </Grid>

                        <Border BorderBrush="{DynamicResource Primary500Brush}" BorderThickness="0,0,0,1" Margin="0,0,0,14" />

                        <!-- Каналы ориентации -->
                        <TextBlock Text="Ориентация и датчики"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMediumEmphasisBrush}"
                                   Margin="0,0,0,12" />

                        <ctrl:ChannelToggle IsChecked="{Binding ShowAngle}"
                                            Label="Угол фильтра (°)"
                                            ChannelColor="{DynamicResource Accent500Brush}" 
                                            Margin="0,0,0,6"/>
                        <ctrl:ChannelToggle IsChecked="{Binding ShowGyro}"
                                            Label="Гироскоп (°/с)"
                                            ChannelColor="{DynamicResource Success500Brush}" 
                                            Margin="0,0,0,6"/>
                        <ctrl:ChannelToggle IsChecked="{Binding ShowTrim}"
                                            Label="Точка баланса Trim (°)"
                                            ChannelColor="{DynamicResource TextHighEmphasisBrush}" 
                                            Margin="0,0,0,6"/>
                        <ctrl:ChannelToggle IsChecked="{Binding ShowAccelAngle}"
                                            Label="Сырой акселерометр (°)"
                                            ChannelColor="{DynamicResource Accent300Brush}" 
                                            Margin="0,0,0,6"/>
                        <ctrl:ChannelToggle IsChecked="{Binding ShowLean}"
                                            Label="Целевой наклон Lean (°)"
                                            ChannelColor="{DynamicResource Warning500Brush}" 
                                            Margin="0,0,0,16"/>

                        <Border BorderBrush="{DynamicResource Primary500Brush}" BorderThickness="0,0,0,1" Margin="0,0,0,14" />

                        <!-- Каналы моторов -->
                        <TextBlock Text="Моторы и контур (об/с)"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMediumEmphasisBrush}"
                                   Margin="0,0,0,12" />

                        <ctrl:ChannelToggle IsChecked="{Binding ShowCmd}"
                                            Label="Команда привода (об/с)"
                                            ChannelColor="{DynamicResource Warning500Brush}" 
                                            Margin="0,0,0,6"/>
                        <ctrl:ChannelToggle IsChecked="{Binding ShowWheelRate}"
                                            Label="Скорость колес (об/с)"
                                            ChannelColor="{DynamicResource Accent300Brush}" 
                                            Margin="0,0,0,6"/>
                        <ctrl:ChannelToggle IsChecked="{Binding ShowTermP}"
                                            Label="Вклад P-члена"
                                            ChannelColor="{DynamicResource Danger500Brush}" 
                                            Margin="0,0,0,6"/>
                        <ctrl:ChannelToggle IsChecked="{Binding ShowTermD}"
                                            Label="Вклад D-члена"
                                            ChannelColor="{DynamicResource TextLowEmphasisBrush}" 
                                            Margin="0,0,0,6"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
