<UserControl x:Class="BalanceBot.Desktop.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель автонастройки с улучшенным оформлением -->
        <Border Grid.Row="0" 
                Background="{DynamicResource Primary700Brush}"
                BorderBrush="{DynamicResource Primary500Brush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,12">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="&#xE9D9; Автотюнинг"
                        Style="{StaticResource ModernButton}"
                        FontSize="{DynamicResource FontSizeBody}"
                        Command="{Binding RunAutotuneCommand}"
                        Margin="0,0,16,0" 
                        Padding="20,12" 
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AutotuneStatusText}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource Accent500Brush}"
                               TextWrapping="Wrap" 
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AutotuneResultText}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource Success500Brush}"
                               TextWrapping="Wrap" 
                               Margin="0,6,0,0"
                               Visibility="{Binding HasAutotuneResult, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="&#xE7A7; Откатить"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="{DynamicResource FontSizeCaption}"
                        Command="{Binding RollbackAutotuneCommand}"
                        IsEnabled="{Binding HasAutotuneResult}"
                        Margin="16,0,0,0" 
                        Padding="14,10" 
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Список параметров с улучшенным оформлением -->
        <Border Grid.Row="1" 
                Background="{DynamicResource Primary700Brush}"
                BorderBrush="{DynamicResource Primary500Brush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Primary600Brush}" 
                                    BorderThickness="0,0,0,1" 
                                    Padding="0,12">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" MinWidth="200" />
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="100" MinWidth="90" />
                                        <ColumnDefinition Width="70" MinWidth="60" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Meta.Key}"
                                                   FontWeight="Bold"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource Accent500Brush}" />
                                        <TextBlock Text="{Binding Meta.About}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextLowEmphasisBrush}"
                                                   TextWrapping="Wrap" 
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Slider Grid.Column="1"
                                            Minimum="{Binding Meta.Min}"
                                            Maximum="{Binding Meta.Max}"
                                            Value="{Binding CurrentValue}"
                                            SmallChange="{Binding SmallChange}"
                                            LargeChange="{Binding LargeChange}"
                                            IsMoveToPointEnabled="True"
                                            AutoToolTipPlacement="TopLeft"
                                            AutoToolTipPrecision="{Binding AutoToolTipPrecision}"
                                            VerticalAlignment="Center"
                                            Margin="16,0"
                                            Style="{StaticResource ModernSlider}" />

                                    <TextBox Grid.Column="2"
                                             Text="{Binding CurrentValue, StringFormat={}{0:F4}}"
                                             Style="{StaticResource ModernTextBox}"
                                             VerticalAlignment="Center"
                                             HorizontalContentAlignment="Center" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Meta.Unit}"
                                               Foreground="{DynamicResource TextLowEmphasisBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               FontSize="{DynamicResource FontSizeCaption}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Нижняя панель с улучшенным оформлением -->
        <Border Grid.Row="2" 
                Background="{DynamicResource Primary700Brush}"
                BorderBrush="{DynamicResource Primary500Brush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,12,0,0">
            <WrapPanel Margin="16">
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextLowEmphasisBrush}"
                           FontSize="{DynamicResource FontSizeBody}"
                           MinWidth="160"
                           MaxWidth="560"
                           TextWrapping="Wrap"
                           Margin="0,6,16,6" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Сброс к заводским"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetToDefaultsCommand}"
                            Margin="0,6,8,6"
                            Padding="14,10" />
                    <Button Content="Применить (RAM)"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding ApplyCommand}"
                            Margin="0,6,8,6"
                            Padding="14,10" />
                    <Button Content="&#xE74E; Сохранить в NVS"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding SaveToNvsCommand}"
                            Padding="14,10"
                            Margin="0,6,0,6" />
                </StackPanel>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
