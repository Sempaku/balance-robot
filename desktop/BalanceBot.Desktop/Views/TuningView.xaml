<UserControl x:Class="BalanceBot.Desktop.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель автонастройки -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="&#xE9D9; Автотюнинг"
                        Style="{StaticResource ModernButton}"
                        FontSize="{StaticResource FontSizeBody}"
                        Command="{Binding RunAutotuneCommand}"
                        Margin="0,0,14,0" Padding="18,10" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AutotuneStatusText}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AutotuneResultText}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource SuccessBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasAutotuneResult, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="&#xE7A7; Откатить"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Command="{Binding RollbackAutotuneCommand}"
                        IsEnabled="{Binding HasAutotuneResult}"
                        Margin="14,0,0,0" Padding="12,8" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Список параметров -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" MinWidth="180" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="90" MinWidth="80" />
                                        <ColumnDefinition Width="60" MinWidth="50" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Meta.Key}"
                                                   FontWeight="Bold"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding Meta.About}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Slider Grid.Column="1"
                                            Minimum="{Binding Meta.Min}"
                                            Maximum="{Binding Meta.Max}"
                                            Value="{Binding CurrentValue}"
                                            VerticalAlignment="Center"
                                            Margin="16,0" />

                                    <TextBox Grid.Column="2"
                                             Text="{Binding CurrentValue, StringFormat={}{0:F4}, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}"
                                             VerticalAlignment="Center"
                                             HorizontalContentAlignment="Center" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Meta.Unit}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontSize="{StaticResource FontSizeCaption}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Сброс к заводским"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetToDefaultsCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Применить (RAM)"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding ApplyCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="&#xE74E; Сохранить в NVS"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding SaveToNvsCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
