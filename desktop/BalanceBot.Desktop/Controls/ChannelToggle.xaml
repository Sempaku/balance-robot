<UserControl x:Class="BalanceBot.Desktop.Controls.ChannelToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BalanceBot.Desktop.Controls">

    <CheckBox IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=local:ChannelToggle}}"
              Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal">
            <Rectangle Width="10" Height="10"
                       Fill="{Binding ChannelColor, RelativeSource={RelativeSource AncestorType=local:ChannelToggle}}"
                       Margin="0,0,8,0" RadiusX="2" RadiusY="2" />
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=local:ChannelToggle}}"
                       FontSize="{StaticResource FontSizeBody}" />
        </StackPanel>
    </CheckBox>
</UserControl>
