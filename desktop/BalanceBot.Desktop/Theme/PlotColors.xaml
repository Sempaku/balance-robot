<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Фон графиков -->
    <Color x:Key="PlotFigureBgColor">#0D0F14</Color>
    <Color x:Key="PlotDataBgColor">#161A22</Color>
    <Color x:Key="PlotAxesColor">#8B95A5</Color>
    <Color x:Key="PlotGridColor">#1E232E</Color>
    <Color x:Key="PlotReferenceLineColor">#2A3040</Color>

    <!-- Каналы ориентации -->
    <Color x:Key="PlotAngleColor">#4A90FF</Color>
    <Color x:Key="PlotGyroColor">#00D084</Color>
    <Color x:Key="PlotTrimColor">#E8ECF1</Color>
    <Color x:Key="PlotAccelAngleColor">#80D8FF</Color>
    <Color x:Key="PlotLeanColor">#FF6D00</Color>

    <!-- Каналы моторов -->
    <Color x:Key="PlotCmdColor">#FFA502</Color>
    <Color x:Key="PlotWheelRateColor">#B388FF</Color>
    <Color x:Key="PlotTermPColor">#FF4081</Color>
    <Color x:Key="PlotTermDColor">#78909C</Color>

    <!-- Bode / BlackBox -->
    <Color x:Key="PlotTrimSignalColor">#FFA502</Color>
    <Color x:Key="PlotLoopMagColor">#4A90FF</Color>
    <Color x:Key="PlotClosedMagColor">#78909C</Color>
    <Color x:Key="PlotLoopPhaseColor">#00D084</Color>
    <Color x:Key="PlotGainCrossoverColor">#00D084</Color>
    <Color x:Key="PlotPhaseCrossoverColor">#FF4081</Color>

</ResourceDictionary>
