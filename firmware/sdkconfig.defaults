CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Тик по умолчанию 100 Гц => FreeRtos::delay_ms(1) спит до 10 мс и контур
# управления не может держать 200 Гц.
CONFIG_FREERTOS_HZ=1000

# Контур управления — это std::thread (pthread). Без привязки он попадает
# на ядро 1 и голодает под спиннящей задачей шаговика (приоритет 10).
CONFIG_PTHREAD_DEFAULT_CORE_0=y
CONFIG_PTHREAD_TASK_PRIO_DEFAULT=10

# --- Обновление по воздуху ---
# Два слота приложения вместо единственного factory (см. partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
# Путь раскрывается от каталога сгенерированного проекта ESP-IDF, а он лежит
# в target/<triple>/<profile>/build/esp-idf-sys-<hash>/out — отсюда шесть
# уровней вверх до корня крейта. Абсолютный путь сюда писать нельзя: файл
# общий для всех машин.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Новая прошивка обязана подтвердить работоспособность, иначе откат на
# предыдущий слот. Без этого битое обновление означало бы поход за кнопками.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Сеть ---
# Сокеты: телеметрия UDP, команды TCP, OTA TCP, плюс запас на портал.
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=24
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=24
